enum ShellGamePhase: byte {
  REVEAL = 0,
  SHUFFLE = 1,
  GUESS = 2,
  ROUND_RESULT = 3
}

table FBShellGameCup {
  x_pos: float;
}

table ShellGameHostPayload {
  phase: ShellGamePhase;
  current_round: ushort;
  time_left: int;          // milliseconds; -1 during SHUFFLE (no timer)
  cups: [FBShellGameCup];
  ball_cup_index: short;   // array index of cup with ball; -1 if hidden
  active_players: ushort;
  map_width: float;
}

root_type ShellGameHostPayload;
